<%- include('partials/header', { pageClass: '' }) %>

<article class="thread-detail surface">
  <div class="detail-head">
    <a href="/profile/<%= thread.author.username %>">
      <img src="<%= thread.author.avatar || '/img/default-avatar.png' %>" class="avatar avatar-md" alt="">
    </a>
    <div class="detail-author-meta">
      <h1><%= thread.author.displayName || thread.author.username %></h1>
      <p>@<%= thread.author.username %></p>
      <% if (thread.author.bio) { %><span><%= thread.author.bio %></span><% } %>
    </div>
  </div>

  <div class="detail-content">
    <p class="detail-text"><%= thread.content %></p>
    <% if (thread.media) { %><img src="<%= thread.media %>" class="detail-image" alt=""><% } %>
  </div>

  <div class="detail-toolbar">
    <button class="icon-btn like-btn" data-id="<%= thread._id %>" data-liked="<%= currentUser && thread.likes.map(String).includes(String(currentUser.id)) ? 'true' : 'false' %>">
      <span class="icon-stroke"><%= currentUser && thread.likes.map(String).includes(String(currentUser.id)) ? 'Liked' : 'Like' %></span>
      <span class="metric"><%= thread.likes.length %></span>
    </button>
    <span class="icon-btn static-btn"><span class="icon-stroke">Replies</span><span class="metric"><%= thread.replies.length %></span></span>
    <% if (currentUser && String(currentUser.id) === String(thread.author._id)) { %>
    <form action="/threads/<%= thread._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Hapus postingan ini?')">
      <button type="submit" class="icon-btn delete-btn">Hapus</button>
    </form>
    <% } %>
  </div>
</article>

<section class="reply-section">
  <div class="section-title-row">
    <h2>Replies</h2>
    <span><%= thread.replies.length %> total</span>
  </div>

  <% if (currentUser) { %>
  <form action="/threads/<%= thread._id %>/reply" method="POST" class="reply-compose">
    <img src="<%= currentUser.avatar || '/img/default-avatar.png' %>" class="avatar avatar-sm" alt="">
    <div class="reply-compose-body">
      <textarea name="content" placeholder="Balas utas ini..." required></textarea>
      <div class="reply-compose-actions">
        <button type="submit" class="btn btn-solid">Kirim</button>
      </div>
    </div>
  </form>
  <% } %>

  <div class="reply-list">
    <% if (thread.replies.length === 0) { %>
      <div class="small-empty"><p style="color:var(--muted);font-size:0.82rem;padding:16px">Belum ada balasan.</p></div>
    <% } %>
    <% thread.replies.slice().reverse().forEach(r => { %>
    <div class="reply-card">
      <img src="<%= r.author && r.author.avatar ? r.author.avatar : '/img/default-avatar.png' %>" class="avatar avatar-sm" alt="">
      <div class="reply-content">
        <div class="reply-topbar">
          <strong><%= r.author ? (r.author.displayName || r.author.username) : 'User' %></strong>
          <span>@<%= r.author ? r.author.username : 'user' %></span>
        </div>
        <p><%= r.content %></p>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
