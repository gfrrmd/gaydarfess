<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>GaydarFess</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/inline-form.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
<nav class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand">GaydarFess</a>
    <div class="topbar-actions">
      <% if (currentUser) { %>
        <a href="/profile/<%= currentUser.username %>" class="topbar-profile-link">Profile</a>
        <a href="/auth/logout" class="btn btn-muted">Keluar</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-muted">Masuk</a>
        <a href="/auth/register" class="btn btn-solid">Daftar</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="app-shell">
