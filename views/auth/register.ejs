<%- include('../partials/header', { pageClass: 'page-auth' }) %>

<section class="auth-shell surface auth-box">
  <div class="auth-head">
    <h1>Daftar</h1>
    <p>Buat akun GaydarFess baru.</p>
  </div>
  <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
  <form action="/auth/register" method="POST" class="auth-form">
    <input type="text" name="username" placeholder="Username" required>
    <input type="text" name="displayName" placeholder="Display name">
    <input type="password" name="password" placeholder="Password" required>
    <button type="submit" class="btn btn-solid full-width">Daftar</button>
  </form>
  <p class="auth-switch">Sudah punya akun? <a href="/auth/login">Masuk</a></p>
</section>

<%- include('../partials/footer') %>
