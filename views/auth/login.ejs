<%- include('../partials/header', { pageClass: 'page-auth' }) %>

<section class="auth-shell surface auth-box">
  <div class="auth-head">
    <h1>Masuk</h1>
    <p>Akses akun GaydarFess kamu.</p>
  </div>
  <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
  <form action="/auth/login" method="POST" class="auth-form">
    <input type="text" name="username" placeholder="Username" required>
    <input type="password" name="password" placeholder="Password" required>
    <button type="submit" class="btn btn-solid full-width">Masuk</button>
  </form>
  <p class="auth-switch">Belum punya akun? <a href="/auth/register">Daftar</a></p>
</section>

<%- include('../partials/footer') %>
